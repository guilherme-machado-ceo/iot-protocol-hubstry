# Configuração de produção do deploy do Nautam na AWS (lida por deploy-aws.yml).
# Só identificadores de recursos, nenhum segredo. Gerado por criar-infra-nautam.sh
# em 03/11/2026. A senha do banco fica apenas no Secrets Manager.
AWS_REGION=sa-east-1
ECR_API_REPO=nautam/api
ECR_DASHBOARD_REPO=nautam/dashboard
ECS_CLUSTER=default
ECS_API_SERVICE=nautam-api
ECS_DASHBOARD_SERVICE=nautam-dashboard
DB_INSTANCE_ID=nautam-db
AWS_DEPLOY_ROLE_ARN=arn:aws:iam::000185047928:role/nautam-github-deploy
ECS_EXECUTION_ROLE_ARN=arn:aws:iam::000185047928:role/nautam-ecs-execution
ECS_TASK_ROLE_ARN=arn:aws:iam::000185047928:role/nautam-ecs-task
ECS_INFRASTRUCTURE_ROLE_ARN=arn:aws:iam::000185047928:role/nautam-ecs-infra
DATABASE_URL_SECRET_ARN=arn:aws:secretsmanager:sa-east-1:000185047928:secret:/nautam/production/database-url-KohXqG
ECS_SUBNETS=subnet-06635664cb4571b8d,subnet-0869e862e25f7a014,subnet-0c9100bfa283b4163
ECS_API_SECURITY_GROUPS=sg-0f1a6a9bb67c52da0
ECS_MIGRATE_SECURITY_GROUPS=sg-0f1a6a9bb67c52da0
ECS_DASHBOARD_SECURITY_GROUPS=sg-0f1a6a9bb67c52da0
CORS_ORIGIN=https://iot-protocol-hubstry.vercel.app
API_BASE_URL=
OPENAQ_SECRET_ARN=arn:aws:secretsmanager:sa-east-1:000185047928:secret:/nautam/production/openaq-api-key-PDbdZO
