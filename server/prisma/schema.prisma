generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Device {
  id               Int      @id @default(autoincrement())
  deviceId         String   @unique
  deviceType       String   @default("generic")
  fundamentalFreq  Float    @default(1000)
  sensors          String   @default("[]")
  harmonicChannels String   @default("{}")
  capabilities     String   @default("[]")
  createdAt        DateTime @default(now())
  lastSeen         DateTime @default(now())

  readings SensorReading[]
}

model SensorReading {
  id        Int      @id @default(autoincrement())
  deviceId  String
  channel   Int
  frequency Float
  value     Float
  unit      String   @default("")
  timestamp DateTime @default(now())

  device Device @relation(fields: [deviceId], references: [deviceId])

  @@index([deviceId, timestamp])
}

model HarmonicProtocolLog {
  id            Int      @id @default(autoincrement())
  fundamentalFreq Float
  channels      String
  message       String?
  createdAt     DateTime @default(now())

  @@index([createdAt])
}

// Chaves de API: só o prefixo e o hash SHA-256 ficam no banco.
model ApiKey {
  id         Int       @id @default(autoincrement())
  name       String
  prefix     String    @unique
  keyHash    String    @unique
  scopes     String[]
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
}

// Nautam Live: leituras públicas reais e execuções do protocolo sobre elas.
// Sem coordenadas, nomes de contribuidores ou contatos (minimização, LGPD).
model LiveRun {
  id               Int       @id @default(autoincrement())
  slotUtc          DateTime  @unique // início do intervalo UTC; impede execução duplicada
  status           String    // running | succeeded | no_new_data | failed
  sources          String[]
  newObservations  Int       @default(0)
  sourceObservedAt DateTime?
  expectedChannels Json?     // preenchido na E2
  decodedPeaks     Json?
  metrics          Json?
  mqttBaseline     Json?
  noiseSeed        String?
  requestedSnrDb   Float?
  measuredSnrDb    Float?
  errorCode        String?
  errorDetail      String?
  startedAt        DateTime  @default(now())
  completedAt      DateTime?

  @@index([status, slotUtc])
  @@index([completedAt])
}

model LiveObservation {
  id          Int      @id @default(autoincrement())
  provider    String   // openaq | ons
  stationRef  String
  sensorRef   String   // identificador estável da série na fonte
  parameter   String
  value       Float
  unit        String
  observedAt  DateTime // instante da medição na fonte (UTC)
  ingestedAt  DateTime @default(now())
  firstRunId  Int?
  locality    String?
  licenseName String
  licenseUrl  String
  attribution String
  sourceUrl   String

  @@unique([provider, sensorRef, observedAt])
  @@index([parameter, observedAt])
  @@index([observedAt])
}
