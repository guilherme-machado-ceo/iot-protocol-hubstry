{
  "name": "harmonic-iot-server",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "apikey": "node dist/cli/apikey.js",
    "migrate": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "seed": "tsx prisma/seed.ts",
    "seed:performance": "tsx prisma/seed.ts --performance",
    "generate": "prisma generate",
    "studio": "prisma studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db-performance": "vitest run tests/performance/",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "live": "node dist/cli/live.js"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1161.0",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@prisma/client": "^5.22.0",
    "fastify": "^5.12.8",
    "pino": "^9.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "overrides": {
    "glob": "^14.0.2"
  }
}
